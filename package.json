{
  "name": "pi-orca-images",
  "version": "0.2.2",
  "description": "Inline images for Pi inside Orca's terminal, plus [Image N] paste labels",
  "type": "module",
  "license": "MIT",
  "author": "JlMoreno00",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JlMoreno00/pi-orca-images.git"
  },
  "homepage": "https://github.com/JlMoreno00/pi-orca-images#readme",
  "bugs": "https://github.com/JlMoreno00/pi-orca-images/issues",
  "keywords": [
    "pi-package",
    "pi",
    "pi-coding-agent",
    "orca",
    "kitty-graphics",
    "inline-images",
    "terminal"
  ],
  "files": [
    "src",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ],
    "image": "https://raw.githubusercontent.com/JlMoreno00/pi-orca-images/main/docs/before-after.png"
  },
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.4.0",
    "@earendil-works/pi-tui": "1.4.0",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
